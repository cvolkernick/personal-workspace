# GitHub (remote pull works publicly; write needs token)
GITHUB_TOKEN=
GITHUB_OWNER=cvolkernick
GITHUB_REPO=personal-workspace
GITHUB_BRANCH=master
# GITHUB_PREFER_LOCAL=1
# LOCAL_WORKSPACE_DIR=/Users/you/personal-workspace

# Google Fit OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GOOGLE_ACCESS_TOKEN=

PORT=8787

# Optional: force timezone for "today" (default = host local tz)
# DASHBOARD_TZ=America/New_York

# Cache / Health refresh
# DASHBOARD_CACHE_TTL_SEC=3600
# DASHBOARD_CACHE_FAIL_TTL_SEC=300
# DASHBOARD_BG_REFRESH_MIN_SEC=900
# HEALTH_INCREMENTAL_DAYS=14
# HEALTH_PULL_TIMEOUT_SEC=60

# HidrateSpark cloud (optional). When set, Day totals are hydration SoT and
# replace overlapping Google Health water days (no double-count with HC).
# HIDRATE_EMAIL=
# HIDRATE_PASSWORD=
# Shared Android client keys — code defaults if unset:
# HIDRATE_APP_ID=a5Il6d0n6WWkLQwBzlxvpF5P7PEkUYkX045CRgwM
# HIDRATE_CLIENT_KEY=mWasknCNtr9dSQGPwUBWb5u4Ilf8Qkeqkwz9Q4eL

# Ask Grok (SuperGrok session in ~/.grok/auth.json also works)
# XAI_MODEL=grok-4.20-non-reasoning
# GROK_ASK_MAX_CONTEXT_CHARS=28000
# GROK_ASK_SESSION_LIMIT=20
# GROK_ASK_HEALTH_DAYS=14
