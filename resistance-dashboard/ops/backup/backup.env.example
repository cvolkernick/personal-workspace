# Copy to ~/.config/resistance-dashboard/backup.env and chmod 600.
# Do not commit the real file.
#
# Fine-grained GitHub PAT with contents:write on cvolkernick/fitdash-backups
# only. Do not reuse the broad workspace token.
FITDASH_BACKUP_GH_TOKEN=

# Optional. Default is ops/backup/recipients.txt next to the script.
# Prefer a path outside the git checkout so a clean cannot remove it:
# FITDASH_BACKUP_RECIPIENTS=/home/prism-agent/.config/resistance-dashboard/backup-recipients.txt

# Optional sha256 list of the served app tree, used when git is not installed.
# FITDASH_BACKUP_CODE_HASHES=/home/prism-agent/.config/resistance-dashboard/code-hashes.txt

# Uncomment only after a prune dry-run looks right. Until then the nightly
# job prints the retention plan and deletes nothing.
# FITDASH_BACKUP_PRUNE_APPLY=1
