{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "python3 scripts/vercel_ignore.py || exit 1",
  "framework": null,
  "outputDirectory": "static",
  "functions": {
    "api/ask.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/exercises/goals.json,fitness/exercises/catalog.json}"
    },
    "api/ask/plan.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/exercises/goals.json,fitness/exercises/catalog.json}"
    },
    "api/ask/grok/start.py": {
      "maxDuration": 15
    },
    "api/ask/grok/poll.py": {
      "maxDuration": 15
    },
    "api/dashboard.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/exercises/goals.json,fitness/exercises/catalog.json}"
    },
    "api/workout-plan/generate.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/exercises/goals.json,fitness/exercises/catalog.json}"
    },
    "api/workout/goals.py": {
      "maxDuration": 15,
      "includeFiles": "{fitness/exercises/goals.json}"
    },
    "api/workout/exercise/available.py": {
      "maxDuration": 15,
      "includeFiles": "{fitness/exercises/goals.json,fitness/exercises/catalog.json}"
    },
    "api/workouts.py": {
      "maxDuration": 30
    }
  }
}
