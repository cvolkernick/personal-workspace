{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "python3 scripts/vercel_ignore.py || exit 1",
  "framework": null,
  "outputDirectory": "static",
  "functions": {
    "api/ask/index.py": {
      "maxDuration": 60
    },
    "api/ask/plan.py": {
      "maxDuration": 60
    },
    "api/ask/grok/start.py": {
      "maxDuration": 15
    },
    "api/ask/grok/poll.py": {
      "maxDuration": 15
    },
    "api/dashboard.py": {
      "maxDuration": 60,
      "includeFiles": "fitness/nutrition/targets.json"
    }
  }
}
