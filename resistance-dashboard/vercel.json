{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "python3 scripts/vercel_ignore.py || exit 1",
  "framework": null,
  "outputDirectory": "static",
  "headers": [
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/agent/today",
      "destination": "/api/dashboard?_r=agent_today"
    },
    {
      "source": "/api/agent/generate-plan",
      "destination": "/api/ask/plan?_r=agent_generate"
    },
    {
      "source": "/api/meal-plan/generate",
      "destination": "/api/dashboard?_r=meal_generate"
    },
    {
      "source": "/api/meal-plan",
      "destination": "/api/dashboard?_r=meal_plan"
    },
    {
      "source": "/api/refresh",
      "destination": "/api/dashboard?_r=refresh"
    },
    {
      "source": "/api/daily-tasks/complete",
      "destination": "/api/dashboard?_r=daily_tasks_complete"
    },
    {
      "source": "/api/daily-tasks",
      "destination": "/api/dashboard?_r=daily_tasks"
    },
    {
      "source": "/api/workout-plan/generate",
      "destination": "/api/ask/plan?_r=generate"
    },
    {
      "source": "/api/workout/goals",
      "destination": "/api/dashboard?_r=goals"
    },
    {
      "source": "/api/workout/exercise/available",
      "destination": "/api/dashboard?_r=available"
    },
    {
      "source": "/api/workout/exercise",
      "destination": "/api/dashboard?_r=exercise"
    },
    {
      "source": "/api/workouts/date",
      "destination": "/api/dashboard?_r=workouts_date"
    },
    {
      "source": "/api/workouts",
      "destination": "/api/dashboard?_r=workouts"
    },
    {
      "source": "/api/inventory/add",
      "destination": "/api/dashboard?_r=inv_add"
    },
    {
      "source": "/api/inventory/update",
      "destination": "/api/dashboard?_r=inv_update"
    },
    {
      "source": "/api/inventory/remove",
      "destination": "/api/dashboard?_r=inv_remove"
    },
    {
      "source": "/api/inventory/stock",
      "destination": "/api/dashboard?_r=inv_stock"
    },
    {
      "source": "/api/equipment/add",
      "destination": "/api/dashboard?_r=eq_add"
    },
    {
      "source": "/api/equipment/update",
      "destination": "/api/dashboard?_r=eq_update"
    },
    {
      "source": "/api/equipment/remove",
      "destination": "/api/dashboard?_r=eq_remove"
    },
    {
      "source": "/api/labs/upload",
      "destination": "/api/dashboard?_r=labs_upload"
    },
    {
      "source": "/api/labs/delete",
      "destination": "/api/dashboard?_r=labs_delete"
    },
    {
      "source": "/api/labs",
      "destination": "/api/dashboard?_r=labs"
    },
    {
      "source": "/api/phase-barometer",
      "destination": "/api/dashboard?_r=phase_barometer"
    },
    {
      "source": "/api/targets",
      "destination": "/api/dashboard?_r=targets"
    },
    {
      "source": "/api/restock/retry",
      "destination": "/api/dashboard?_r=restock_retry"
    },
    {
      "source": "/api/restock/cart",
      "destination": "/api/dashboard?_r=restock_cart"
    },
    {
      "source": "/api/restock/confirm",
      "destination": "/api/dashboard?_r=restock_confirm"
    },
    {
      "source": "/api/restock",
      "destination": "/api/dashboard?_r=restock"
    },
    {
      "source": "/api/recipes/delete",
      "destination": "/api/dashboard?_r=recipes_delete"
    },
    {
      "source": "/api/recipes/log",
      "destination": "/api/dashboard?_r=recipes_log"
    },
    {
      "source": "/api/recipes",
      "destination": "/api/dashboard?_r=recipes"
    }
  ],
  "functions": {
    "api/ask.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/nutrition/inventory.json,fitness/exercises/goals.json,fitness/exercises/catalog.json,fitness/exercises/equipment.json,fitness/gym/busyness.json}"
    },
    "api/ask/plan.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/nutrition/inventory.json,fitness/exercises/goals.json,fitness/exercises/catalog.json,fitness/exercises/equipment.json,fitness/gym/busyness.json}"
    },
    "api/ask/grok/start.py": {
      "maxDuration": 15
    },
    "api/ask/grok/poll.py": {
      "maxDuration": 15
    },
    "api/dashboard.py": {
      "maxDuration": 60,
      "includeFiles": "{fitness/nutrition/targets.json,fitness/nutrition/inventory.json,fitness/exercises/goals.json,fitness/exercises/catalog.json,fitness/exercises/equipment.json,fitness/gym/busyness.json,projects-dashboard/google_tasks.py}"
    }
  }
}
