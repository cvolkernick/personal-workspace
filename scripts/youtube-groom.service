[Unit]
Description=YouTube AI Curated hourly groom
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/lib/youtube-groom/youtube_groom.py
# Health + tick report + #852 control loop run after success *or* fail.
# Leading '-' = missing script is non-fatal.
# Do not point ExecStart at nest youtube_groom.py (policy scorecard).
ExecStopPost=-/usr/bin/python3 %h/.local/lib/youtube-groom/youtube_groom_health.py
ExecStopPost=-/usr/bin/python3 %h/.local/lib/youtube-groom/youtube_groom_tick_report.py
# Tick-report already ran the loop. --apply-timer still writes the drop-in
# even when last_tick.at makes the loop an idempotent replay.
ExecStopPost=-/usr/bin/python3 %h/.local/lib/youtube-groom/youtube_groom_control.py --apply-timer
Nice=10

[Install]
WantedBy=default.target
