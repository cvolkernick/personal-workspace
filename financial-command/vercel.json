{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/treasury_latest.json", "destination": "/api?_r=denied_static" },
    { "source": "/api/treasury", "destination": "/api?_r=treasury" },
    { "source": "/api/config", "destination": "/api?_r=config" },
    { "source": "/api/refresh", "destination": "/api?_r=refresh" },
    { "source": "/api/trade", "destination": "/api?_r=trade" },
    { "source": "/api/trade/:path*", "destination": "/api?_r=trade" },
    { "source": "/api/mint", "destination": "/api?_r=mint" },
    { "source": "/api/mint/:path*", "destination": "/api?_r=mint" },
    { "source": "/api/health", "destination": "/api?_r=health" },
    { "source": "/api/fcc-identity", "destination": "/api?_r=health" },
    { "source": "/api/watchlist", "destination": "/api?_r=watchlist" },
    { "source": "/api/watchlist/:path*", "destination": "/api?_r=watchlist" },
    { "source": "/api/capital-flows", "destination": "/api?_r=capital-flows" },
    { "source": "/api/braiins", "destination": "/api?_r=braiins" },
    { "source": "/api/coach", "destination": "/api?_r=coach" },
    { "source": "/api/ask", "destination": "/api?_r=ask" },
    { "source": "/api/ask/:path*", "destination": "/api?_r=ask" },
    { "source": "/api/advisor", "destination": "/api?_r=ask" },
    { "source": "/api/advisor/:path*", "destination": "/api?_r=ask" },
    { "source": "/api/open-orchestra", "destination": "/api?_r=orchestra" },
    { "source": "/api/orchestra-status", "destination": "/api?_r=orchestra" },
    { "source": "/api/launch-orchestra", "destination": "/api?_r=orchestra" },
    { "source": "/api/:path*", "destination": "/api?_r=other" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10
    }
  }
}
