[Unit]
Description=IoT dashboard + schedule worker (HTTP on LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/iot-workspace
Environment=PYTHONPATH=/home/pi/iot-workspace
Environment=PYTHONUNBUFFERED=1
# pywizlight can open many UDP sockets under load; raise soft cap above 1024
# so a transient leak does not immediately EMFILE the process (see FD-close
# fix in wiz_adapter.py).
LimitNOFILE=65536
# Bind all interfaces so phones/Mac can open http://<pi-ip>:8780/
# Prefer venv created by install_remote.sh; install script rewrites path
# --local: this host IS the backend (do not proxy via backend.json)
ExecStart=/home/pi/iot-workspace/.venv/bin/python /home/pi/iot-workspace/iot/server.py --host 0.0.0.0 --port 8780 --no-browser --local
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
