[Unit]
Description=IoT headless schedule worker (Wiz sunrise/sunset routines)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/Group and WorkingDirectory for your Pi
User=pi
Group=pi
WorkingDirectory=/home/pi/iot-workspace
Environment=PYTHONPATH=/home/pi/iot-workspace
Environment=PYTHONUNBUFFERED=1
# Prefer venv created by install_remote.sh; install script rewrites path
ExecStart=/home/pi/iot-workspace/.venv/bin/python /home/pi/iot-workspace/iot/worker.py --interval 30
Restart=always
RestartSec=10

# Hardening (optional; comment out if path issues)
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
