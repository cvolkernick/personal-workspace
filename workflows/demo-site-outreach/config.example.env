# Copy to a local env file outside git. Never commit real values.
# Names only — this file is safe to keep in the repo.

# Canonical store (JSON file). Default: ~/.local/share/demo-site-outreach/store.json
# DEMO_SITE_OUTREACH_STORE=

# Live sends stay blocked until the Chairman approves templates/v1.
# DEMO_SITE_OUTREACH_TEMPLATE_APPROVED=1
# DEMO_SITE_OUTREACH_LIVE=1

# CAN-SPAM
# DEMO_SITE_OUTREACH_FROM_EMAIL=
# DEMO_SITE_OUTREACH_PHYSICAL_ADDRESS=
# DEMO_SITE_OUTREACH_SMTP_HOST=
# DEMO_SITE_OUTREACH_SMTP_PORT=587
# DEMO_SITE_OUTREACH_SMTP_USER=
# DEMO_SITE_OUTREACH_SMTP_PASS=

# Places (read). Bland / Vercel / alert (send). Agent ID is never logged.
# GOOGLE_PLACES_API_KEY=
# BLAND_API_KEY=
# BLAND_AGENT_ID=
# BLAND_FROM_NUMBER=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# DEMO_SITE_OUTREACH_ALERT_WEBHOOK=
# DEMO_SITE_OUTREACH_WEBHOOK_SECRET=
# DEMO_SITE_OUTREACH_WEBHOOK_URL=

# Caps / retention
# DEMO_SITE_OUTREACH_DAILY_SMS_CAP=20
# DEMO_SITE_OUTREACH_RETENTION_DAYS=30
