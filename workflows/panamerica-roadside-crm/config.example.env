# Copy to a local env file outside git. Never commit real values.
# Names only — this file is safe to keep in the repo.

# Canonical store (JSON file). Default: ~/.local/share/panamerica-roadside-crm/store.json
# PANAMERICA_ROADSIDE_STORE=

# Intake folder (created 2026-09-17). Not a secret.
# PANAMERICA_ROADSIDE_DRIVE_FOLDER_ID=1QS6rqyApNDCrsJ90mp83rnbEthlzznxy

# Copy is Chris-approved (#855). First live send still needs this human gate.
# PANAMERICA_ROADSIDE_COPY_APPROVED=1
# PANAMERICA_ROADSIDE_LIVE=1

# Variant B is not an env flag (#896). It stays unassigned until a
# Chris-approved copy change sets SMS_VARIANT_B_APPROVED in outreach_copy.py.
# Until then sms-batch assigns 100% A (ab_mode=champion_only).

# Bland (send). Agent ID is never logged.
# BLAND_API_KEY=
# BLAND_AGENT_ID=
# BLAND_FROM_NUMBER=

# Drive list (live daily-pass). Dry-run uses --fixture instead.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Cloud Vision OCR (live intake). Never commit the key.
# GOOGLE_VISION_API_KEY=
# PANAMERICA_ROADSIDE_VISION_API_KEY=

# PANAMERICA_ROADSIDE_ALERT_WEBHOOK=
# PANAMERICA_ROADSIDE_WEBHOOK_SECRET=
# PANAMERICA_ROADSIDE_WEBHOOK_URL=

# Caps / cadence
# PANAMERICA_ROADSIDE_DAILY_SMS_CAP=20
# PANAMERICA_ROADSIDE_VOICE_DELAY_MIN_DAYS=5
# PANAMERICA_ROADSIDE_VOICE_DELAY_MAX_DAYS=7
