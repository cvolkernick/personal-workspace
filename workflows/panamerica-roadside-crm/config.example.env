# Copy to a local env file outside git. Never commit real values.
# Names only — this file is safe to keep in the repo.

# Canonical store (JSON file) on prism-gateway (#1048).
# Default: ~/.local/share/panamerica-roadside-crm/store.json (mode 600)
# The box copy is not a second writer. P1 (#1049) replaces this file with SQLite.
# PANAMERICA_ROADSIDE_STORE=

# P1 backend. Default file. Flip to crm only after importer parity.
# PANAMERICA_ROADSIDE_BACKEND=file
# PANAMERICA_CRM_DB=
# CRM_API_URL=
# CRM_TOKEN=

# Intake folder (created 2026-09-17). Not a secret.
# PANAMERICA_ROADSIDE_DRIVE_FOLDER_ID=1QS6rqyApNDCrsJ90mp83rnbEthlzznxy

# Copy is Chris-approved (#855). First live send still needs this human gate.
# PANAMERICA_ROADSIDE_COPY_APPROVED=1
# PANAMERICA_ROADSIDE_LIVE=1

# Variant B is not an env flag (#896). It stays unassigned until a
# Chris-approved copy change sets SMS_VARIANT_B_APPROVED in outreach_copy.py.
# Until then sms-batch assigns 100% A (ab_mode=champion_only).

# Outbound SMS uses prism send-904 (local bland-relay → SMSGate), which
# originates on the 904 handset +19043343975. This is not Bland's SMS API.
# BLAND_FROM_NUMBER is a lock, not a Bland caller ID: unset or
# +19043343975 selects that rail; 906 (+19062406221) and any other value
# are refused before a send. Do not set BLAND_FROM_NUMBER=+19043343975
# on the Bland SMS API — Bland cannot originate from this handset.
# BLAND_API_KEY=
# BLAND_AGENT_ID=
# BLAND_FROM_NUMBER=
# SEND904_BIN=

# Live voice is fail-closed. Bland cannot place a call from the 904
# handset, and this workflow will not originate on 906.

# Drive list (live daily-pass). Dry-run uses --fixture instead.
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Cloud Vision OCR (live intake). Never commit the key.
# GOOGLE_VISION_API_KEY=
# PANAMERICA_ROADSIDE_VISION_API_KEY=

# PANAMERICA_ROADSIDE_ALERT_WEBHOOK=
# PANAMERICA_ROADSIDE_WEBHOOK_SECRET=
# PANAMERICA_ROADSIDE_WEBHOOK_URL=

# Caps / cadence
# PANAMERICA_ROADSIDE_DAILY_SMS_CAP=20
# PANAMERICA_ROADSIDE_VOICE_DELAY_MIN_DAYS=5
# PANAMERICA_ROADSIDE_VOICE_DELAY_MAX_DAYS=7
