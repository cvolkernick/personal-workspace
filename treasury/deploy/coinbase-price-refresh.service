[Unit]
Description=Coinbase BTC/USD spot producer (prism/Pi SoT, #695)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=prism-agent
Group=prism-agent
WorkingDirectory=/home/prism-agent/personal-workspace
ExecStart=/home/prism-agent/personal-workspace/treasury/coinbase_price_refresh.sh
Environment=HOME=/home/prism-agent
Environment=FCC_HOST_TAG=prism
Environment=TREASURY_SKIP_PUSH_PI=1
Environment=PATH=/home/prism-agent/.grok/bin:/home/prism-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
# Public spot only. No Coinbase CLI, no node, no secrets.

[Install]
WantedBy=multi-user.target
