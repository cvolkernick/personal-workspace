<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RETIRED (#689). Pi is the Braiins producer (braiins-refresh.timer).
  Do not bootstrap this LaunchAgent — it would dual-write braiins_latest.json.

  Unload if still present:
    launchctl bootout gui/$(id -u)/com.personalworkspace.braiins-refresh 2>/dev/null || true
    rm -f ~/Library/LaunchAgents/com.personalworkspace.braiins-refresh.plist

  See treasury/deploy/BRAIINS_PRODUCER.md
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personalworkspace.braiins-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/true</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>Disabled</key>
  <true/>
</dict>
</plist>
