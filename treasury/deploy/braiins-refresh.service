[Unit]
Description=Braiins Pool snapshot producer (prism/Pi SoT, #689)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=prism-agent
Group=prism-agent
WorkingDirectory=/home/prism-agent/personal-workspace
ExecStart=/home/prism-agent/personal-workspace/treasury/braiins_refresh.sh
Environment=HOME=/home/prism-agent
Environment=FCC_HOST_TAG=prism
Environment=TREASURY_SKIP_PUSH_PI=1
Environment=PATH=/home/prism-agent/.grok/bin:/home/prism-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
# Read-only pool stats. Token: ~/.config/braiins/token (mode 600). Never treasury/config.json.

[Install]
WantedBy=multi-user.target
