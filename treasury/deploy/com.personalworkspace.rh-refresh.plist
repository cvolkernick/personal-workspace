<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BACKUP / CONSUMER ONLY — Issue #518.

  Eng-gate: do NOT bootout this unit until Pi OAuth is healthy AND
  Pi smoke has moved robinhood_latest.json / FCC as_of (RH_PRODUCER.md
  steps 1–2). Disarming first = no writer. Leaving it loaded after Pi
  SoT = dual-writer. Mac tokens do not travel.

  Disarm (step 3 — only after Pi smoke green). #555: stay unloaded.
  Do NOT reload this unit. False RH ntfy leftover is fund-manager-daily /
  fund-manager-bp-poll (gated in nest) — not this plist.
    launchctl bootout gui/$(id -u)/com.personalworkspace.rh-refresh 2>/dev/null || true
    rm -f ~/Library/LaunchAgents/com.personalworkspace.rh-refresh.plist

  Optional backup (laptop FCC only; still no RH push):
    export TREASURY_RH_ROLE=backup   # then load this plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.personalworkspace.rh-refresh.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personalworkspace.rh-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/cvolkernick/personal-workspace-worktrees/treasury/treasury/rh_refresh.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/cvolkernick/personal-workspace-worktrees/treasury</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/Users/cvolkernick/.local/bin:/usr/local/bin:/Users/cvolkernick/.grok/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/cvolkernick</string>
    <key>FCC_HOST_TAG</key>
    <string>mac</string>
    <key>TREASURY_RH_ROLE</key>
    <string>consumer</string>
    <key>TREASURY_RH_SOT_HOST</key>
    <string>prism</string>
    <!-- Pull Pi SoT; do not run Mac MCP; do not push RH back -->
    <key>TREASURY_SKIP_LOCAL_MCP</key>
    <string>1</string>
    <key>TREASURY_SKIP_PUSH_PI</key>
    <string>1</string>
    <key>TREASURY_RH_MCP_TIMEOUT_S</key>
    <string>240</string>
    <key>TREASURY_RH_MAX_AGE_HOURS</key>
    <string>6</string>
  </dict>
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/cvolkernick/personal-workspace-worktrees/treasury/treasury/snapshots/rh_refresh_launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cvolkernick/personal-workspace-worktrees/treasury/treasury/snapshots/rh_refresh_launchd.err.log</string>
</dict>
</plist>
