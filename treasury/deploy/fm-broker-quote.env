# Read-only quote environment for every run_treasury writer.
# Same three variables as /etc/systemd/system/fund-manager-bp-poll.service.d/20-broker-adapter.conf
# (and fund-manager.service.d). Copied from investment/FUND_MANAGER_RUNBOOK.md.
# get_quotes only. Loading this file does not place, queue, or cancel an order.
FM_BROKER_ADAPTER=treasury.fund_manager_broker:submit
FM_BROKER_CLIENT=grok_mcp
FM_BROKER_GROK_BIN=/home/prism-agent/.grok/bin/grok
