<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cvolkernick.context-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/cvolkernick/personal-workspace/ops/context/persist.py</string>
    <string>backup</string>
    <string>--apply</string>
    <string>--config</string>
    <string>/Users/cvolkernick/.config/personal-workspace/context-persist.json</string>
    <string>--workspace</string>
    <string>/Users/cvolkernick/personal-workspace</string>
    <string>--out</string>
    <string>/Users/cvolkernick/personal-workspace/ops/context/reports</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/cvolkernick/personal-workspace</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GROK_HOME</key>
    <string>/Users/cvolkernick/.grok</string>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/cvolkernick/Library/Logs/personal-workspace/context-backup.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cvolkernick/Library/Logs/personal-workspace/context-backup.launchd.err.log</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
