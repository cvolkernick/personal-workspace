{
  "pi_host": "prism-gateway",
  "pi_label": "prism-gateway",
  "scheme": "http",
  "notes": "Always-on dashboard backends live on the Pi. pi_host is the tailnet MagicDNS short name. Override with env PI_HOST or DASHBOARD_HOST. financial-command (:8000) and horizon (:8795) bind 127.0.0.1: their links come from PRISM_PUBLIC_BASE (loopback fallback) and they are probed on 127.0.0.1, never on pi_host.",
  "services": {
    "orchestra": { "port": 8790, "path": "/", "health": "/api/health" },
    "financial-command": {
      "port": 8000,
      "path": "/financial-command/index.html",
      "health": "/api/health"
    },
    "projects-dashboard": { "port": 8765, "path": "/", "health": "/api/health" },
    "holistic": { "port": 8770, "path": "/", "health": "/api/health" },
    "iot": { "port": 8780, "path": "/", "health": "/api/health" },
    "resistance-dashboard": {
      "port": 8787,
      "path": "/",
      "health": "/api/healthz"
    },
    "auto-fleet": { "port": 8796, "path": "/", "health": "/api/health" },
    "horizon": { "port": 8795, "path": "/", "health": "/api/health" },
    "oomwoo": { "port": 8798, "path": "/", "health": "/api/health" },
    "life-compass": { "port": 8793, "path": "/", "health": "/api/health" }
  }
}
