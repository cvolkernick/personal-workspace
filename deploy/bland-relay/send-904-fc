#!/usr/bin/env python3
"""send-904-fc: first-contact numbers for the 904 relay (#1100).

  send-904-fc add --to +1XXXXXXXXXX --name NAME --kind lead|renter|vendor \
      --purpose TEXT --by SEAT
  send-904-fc list [--status active|pending|expired|converted|revoked|opted_out]
  send-904-fc revoke --to +1XXXXXXXXXX --reason TEXT --by SEAT

Approval is OFF by default (relay FC_REQUIRE_APPROVAL=0): `add` puts the number
on the first-contact allowlist as active right away, no code. The relay still
refuses opted-out numbers (until they text START), enforces FC_DAILY_MAX new
numbers per 24h (re-adding a revoked/expired/opted-out number counts), the TTL,
FC_MAX_SENDS_BEFORE_REPLY, the rate limits and both kill switches. Then send
with send-904 as usual.

Only when the relay runs with FC_REQUIRE_APPROVAL=1:
  send-904-fc request ...   (same arguments as add; returns a 6-digit code)
  send-904-fc approve --to +1XXXXXXXXXX --code 123456 --approver chris \
      --text "yes 123456" --ref CHAT_OR_MESSAGE_REF
With approval off, `request` behaves like `add` and `approve` returns
409 approval_not_required.

add/request/list/revoke use SEND_TOKEN and FC_PATH from
~/.config/bland-relay/env. approve needs the approver token, which is NOT in
that file (the relay keeps only its SHA-256): pass it on stdin with
--token-stdin, or in the FC_APPROVE_TOKEN environment variable. Never prints
tokens or paths.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

ENV_FILE = os.path.expanduser("~/.config/bland-relay/env")
BASE = os.environ.get("SEND904_BASE", "http://127.0.0.1:8799").rstrip("/")


def load_env(path):
    out = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            s = line.strip()
            if not s or s.startswith("#") or "=" not in s:
                continue
            k, v = s.split("=", 1)
            k = k.strip()
            if k.startswith("export "):
                k = k[7:].strip()
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            out[k] = v
    return out


def parse(argv):
    ap = argparse.ArgumentParser(
        prog="send-904-fc", description="904 first-contact numbers (#1100). Approval is off by default "
        "(relay FC_REQUIRE_APPROVAL=0): `add` allows a number at once.")
    sub = ap.add_subparsers(dest="action", required=True)
    for verb, desc in (("add", "allow a new number now (approval off, the default)"),
                       ("request", "approval on: ask for a code; approval off: same as add")):
        r = sub.add_parser(verb, help=desc, description=desc)
        r.add_argument("--to", required=True)
        r.add_argument("--name", required=True)
        r.add_argument("--kind", required=True, choices=["lead", "renter", "vendor"])
        r.add_argument("--purpose", required=True)
        r.add_argument("--by", required=True, help="adding seat, e.g. alexandra")
    a = sub.add_parser("approve", help="only with FC_REQUIRE_APPROVAL=1")
    a.add_argument("--to", required=True)
    a.add_argument("--code", required=True)
    a.add_argument("--approver", required=True, help="the human who typed yes, e.g. chris")
    a.add_argument("--text", required=True, help="the user's typed approval, verbatim")
    a.add_argument("--ref", required=True, help="chat/message reference for the approval")
    a.add_argument("--token-stdin", action="store_true", help="read the approver token from stdin")
    ls = sub.add_parser("list")
    ls.add_argument("--status", default="all")
    v = sub.add_parser("revoke")
    v.add_argument("--to", required=True)
    v.add_argument("--reason", required=True)
    v.add_argument("--by", required=True)
    return ap.parse_args(argv)


def body_for(ns):
    if ns.action in ("add", "request"):
        return {"action": ns.action, "to": ns.to, "name": ns.name, "purpose_kind": ns.kind,
                "purpose": ns.purpose, "requested_by": ns.by}
    if ns.action == "approve":
        return {"action": "approve", "to": ns.to, "code": ns.code, "approver": ns.approver,
                "approval_text": ns.text, "approval_ref": ns.ref}
    if ns.action == "list":
        return {"action": "list", "status": ns.status}
    return {"action": "revoke", "to": ns.to, "reason": ns.reason, "revoked_by": ns.by}


def main(argv=None):
    ns = parse(sys.argv[1:] if argv is None else argv)
    try:
        envf = load_env(ENV_FILE)
    except OSError as e:
        print("error: cannot read relay env file (%s)" % type(e).__name__, file=sys.stderr)
        return 3
    path = envf.get("FC_PATH", "").lstrip("/")
    if ns.action == "approve":
        token = sys.stdin.readline().strip() if ns.token_stdin else os.environ.get("FC_APPROVE_TOKEN", "").strip()
        if not token:
            print("error: approve needs the approver token (--token-stdin or FC_APPROVE_TOKEN)", file=sys.stderr)
            return 3
    else:
        token = envf.get("SEND_TOKEN", "")
    if not token or not path:
        print("error: FC_PATH or token missing", file=sys.stderr)
        return 3
    req = urllib.request.Request(
        BASE + "/" + path, data=json.dumps(body_for(ns)).encode("utf-8"), method="POST",
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + token},
    )
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            code, raw = r.status, r.read()
    except urllib.error.HTTPError as e:
        code, raw = e.code, e.read()
    except Exception as e:  # noqa: BLE001 - never echo URL/token
        print("error: request to relay failed (%s)" % type(e).__name__, file=sys.stderr)
        return 4
    text = raw.decode("utf-8", "replace")
    try:
        text = json.dumps(json.loads(text), ensure_ascii=False, indent=1)
    except Exception:  # noqa: BLE001
        pass
    for secret in (token, path, envf.get("SEND_TOKEN", "")):
        if secret and secret in text:
            text = text.replace(secret, "[REDACTED]")
    print(code)
    print(text)
    return 0 if 200 <= code < 300 else 1


if __name__ == "__main__":
    sys.exit(main())
