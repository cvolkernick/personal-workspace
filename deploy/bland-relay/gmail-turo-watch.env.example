# ~/.config/gmail-turo-watch/env (chmod 600). Placeholders only; never commit real values.
GMAIL_TOKEN_PATH=/home/<user>/.config/auto-fleet/gmail-token.json
# Topic must live in the GCP project that owns the Gmail OAuth client (Gmail rule).
GMAIL_WATCH_TOPIC=projects/<oauth-client-project>/topics/gmail-turo
GMAIL_WATCH_SUBSCRIPTION=projects/<oauth-client-project>/subscriptions/gmail-turo-pi
# Optional: only accept notifications for this mailbox.
GMAIL_WATCH_EMAIL=<panamerica-mailbox>
# Optional: narrow the watch (default: all mail; co-host guest mail skips INBOX).
# GMAIL_WATCH_LABEL_IDS=
TURO_EMAIL_RELAY_URL=http://127.0.0.1:8797/turo/email
TURO_EMAIL_TOKEN=<same value as TURO_EMAIL_TOKEN in ~/.config/bland-relay/env>
GOOGLE_APPLICATION_CREDENTIALS=/home/<user>/.config/gmail-turo-watch/subscriber-sa.json
# TURO_EMAIL_MAX_AGE_S=43200
