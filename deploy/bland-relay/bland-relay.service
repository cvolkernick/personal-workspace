# Copy this set into ~/bin together or the unit crash-loops. Modes, backup,
# and rollback are in deploy/bland-relay/README.md (Deploy).
#   bland-relay.py  bland_relay.py  relay_config.py  relay_audit.py
#   relay_sms.py  relay_fc.py  relay_send.py  relay_rcs.py  relay_turo.py
#   relay_helm_sms.py  relay_http.py  caller_context.py  turo_email.py  meeting_check.py  post_call.py
[Unit]
Description=Bland post-call webhook relay -> Alexandra alert endpoint
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/bland-relay/env
Environment=RELAY_HOST=127.0.0.1 RELAY_PORT=8799 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/bin/bland-relay.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
