#!/usr/bin/env bash
# Usage: printf %s "$VALUE" | bland-relay-setkey KEY
# Reads the value from stdin (never argv), writes ~/.config/bland-relay/env
# atomically, and restarts the unit. Never prints the value.
set -euo pipefail
KEY="${1:-}"
case "$KEY" in
  ALEXANDRA_ALERT_URL|ALEXANDRA_ALERT_AUTH|BLAND_WEBHOOK_SECRET|RELAY_PATH|\
  FWD_TOKEN|FWD_PATH|SEND_TOKEN|SEND_PATH|SMSGW_URL|SMSGW_USER|SMSGW_PASS|\
  SMSGW_HOOK_PATH|SMSGW_SIGNING_KEY|SMS_SEND_DISABLED|\
  RCS_HOOK_PATH|RCS_HOOK_TOKEN|RCS_NAME_MAP|RCS_HOOK_DISABLED|RCS_DEDUPE_WAIT_S|\
  FC_PATH|FC_APPROVE_TOKEN_SHA256|FC_APPROVERS|FC_AGENT_SEATS|FC_APPROVER_NUMBERS|\
  FC_DAILY_MAX|FC_TTL_DAYS|FC_MAX_SENDS_BEFORE_REPLY|FC_DISABLED|FC_REQUIRE_APPROVAL|CRM_INGEST_MODE|CRM_OUTBOX_PATH|\
  TURO_HOOK_DISABLED|TURO_OWNER_ALERT_TO|TURO_OWNER_ALERT_DISABLED|TURO_SUPPRESS_RE|TURO_URGENT_NEG|TURO_URGENT_RE_LOCKOUT|TURO_URGENT_RE_NO_START|TURO_URGENT_RE_ACCIDENT_DAMAGE|TURO_URGENT_RE_CHARGING|TURO_URGENT_RE_SAFETY|\
  TURO_DEDUPE_WINDOW_S|TURO_ALERT_GUEST_WINDOW_S|TURO_ALERT_GUEST_MAX|TURO_ALERT_HOUR_MAX|TURO_INBOX_PATH|TURO_RETENTION_DAYS|TURO_WEBHOOK_TIMEOUT_S|TURO_ALEX_PUSH_DISABLED|HELM_TURO_WEBHOOK_URL|HELM_TURO_WEBHOOK_KEY|HELM_TURO_WEBHOOK_HEADER) ;;
  *)
    echo "usage: printf %s VALUE | $0 KEY" >&2
    echo "KEY is one of: ALEXANDRA_ALERT_URL ALEXANDRA_ALERT_AUTH BLAND_WEBHOOK_SECRET RELAY_PATH FWD_TOKEN FWD_PATH SEND_TOKEN SEND_PATH SMSGW_URL SMSGW_USER SMSGW_PASS SMSGW_HOOK_PATH SMSGW_SIGNING_KEY SMS_SEND_DISABLED RCS_HOOK_PATH RCS_HOOK_TOKEN RCS_NAME_MAP RCS_HOOK_DISABLED RCS_DEDUPE_WAIT_S FC_PATH FC_APPROVE_TOKEN_SHA256 FC_APPROVERS FC_AGENT_SEATS FC_APPROVER_NUMBERS FC_DAILY_MAX FC_TTL_DAYS FC_MAX_SENDS_BEFORE_REPLY FC_DISABLED FC_REQUIRE_APPROVAL CRM_INGEST_MODE CRM_OUTBOX_PATH TURO_HOOK_DISABLED TURO_OWNER_ALERT_TO TURO_OWNER_ALERT_DISABLED TURO_SUPPRESS_RE TURO_URGENT_NEG TURO_URGENT_RE_LOCKOUT TURO_URGENT_RE_NO_START TURO_URGENT_RE_ACCIDENT_DAMAGE TURO_URGENT_RE_CHARGING TURO_URGENT_RE_SAFETY TURO_DEDUPE_WINDOW_S TURO_ALERT_GUEST_WINDOW_S TURO_ALERT_GUEST_MAX TURO_ALERT_HOUR_MAX TURO_INBOX_PATH TURO_RETENTION_DAYS TURO_WEBHOOK_TIMEOUT_S TURO_ALEX_PUSH_DISABLED HELM_TURO_WEBHOOK_URL HELM_TURO_WEBHOOK_KEY HELM_TURO_WEBHOOK_HEADER" >&2
    exit 2
    ;;
esac
if [ -t 0 ]; then read -rs -p "value for $KEY (hidden): " VAL; echo >&2; else VAL="$(cat)"; fi
VAL="${VAL%$'\n'}"; VAL="${VAL%$'\r'}"
case "$VAL" in *$'\n'*) echo "value must be one line" >&2; exit 2;; esac
if [ "$KEY" = "FC_APPROVE_TOKEN_SHA256" ]; then
  case "$VAL" in
    *[!0-9a-f]*|"") echo "FC_APPROVE_TOKEN_SHA256 must be 64 lowercase hex chars (sha256 of the token, never the token)" >&2; exit 2;;
  esac
  [ "${#VAL}" -eq 64 ] || { echo "FC_APPROVE_TOKEN_SHA256 must be 64 hex chars" >&2; exit 2; }
fi
if [ "$KEY" = "SMS_SEND_DISABLED" ] || [ "$KEY" = "RCS_HOOK_DISABLED" ] || [ "$KEY" = "FC_DISABLED" ] || [ "$KEY" = "FC_REQUIRE_APPROVAL" ] || \
   [ "$KEY" = "TURO_HOOK_DISABLED" ] || [ "$KEY" = "TURO_OWNER_ALERT_DISABLED" ] || [ "$KEY" = "TURO_ALEX_PUSH_DISABLED" ]; then
  case "$VAL" in
    0|1) ;;
    *) echo "$KEY must be 0 or 1" >&2; exit 2;;
  esac
fi
if [ "$KEY" = "TURO_OWNER_ALERT_TO" ]; then
  # The relay refuses any other number; refuse it here too so a typo is loud.
  D="$(printf %s "$VAL" | tr -cd '0-9')"; [ "${#D}" -eq 10 ] && D="1$D"
  [ "$D" = "12073100000" ] || { echo "TURO_OWNER_ALERT_TO must be the owner's cell (+12073100000)" >&2; exit 2; }
  VAL="+12073100000"
fi
ENVF="$HOME/.config/bland-relay/env"
KEY="$KEY" VAL="$VAL" ENVF="$ENVF" python3 - <<'PY'
import os, tempfile
p=os.environ["ENVF"]; k=os.environ["KEY"]; v=os.environ["VAL"]
lines=open(p).read().splitlines() if os.path.exists(p) else []
out=[]; done=False
for l in lines:
    if l.split("=",1)[0].strip()==k:
        if not done: out.append(f"{k}={v}"); done=True
    else: out.append(l)
if not done: out.append(f"{k}={v}")
d=os.path.dirname(p); os.makedirs(d, mode=0o700, exist_ok=True)
fd,tmp=tempfile.mkstemp(dir=d, prefix=".env.")
with os.fdopen(fd,"w") as f: f.write("\n".join(out)+"\n")
os.chmod(tmp,0o600); os.replace(tmp,p)
PY
systemctl --user reset-failed bland-relay.service 2>/dev/null || true
systemctl --user restart bland-relay.service
sleep 1
echo "$KEY updated (len ${#VAL}); bland-relay.service: $(systemctl --user is-active bland-relay.service)"
