[Unit]
Description=FCC tip SHA / branch-attachment health assert (#562)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
# Never mutates git. Durable copy survives FCC hard-reset (deploy/ is master-only).
ExecStart=/usr/bin/python3 %h/.config/personal-workspace/fcc_tip_health.py --workspace %h/personal-workspace --fetch
