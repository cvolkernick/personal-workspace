[Unit]
Description=PULSE LOCK: hourly :20 America/New_York — one pull (books + youtube-groom + published + units)

[Timer]
# PULSE LOCK (do not add a second timer)
# Cadence: hourly at minute 20, America/New_York, all 7 days including overnight.
# One systemd timer, one job (b2-puller.service).
# Pulls together: book snapshots, youtube-groom state, published copies, units.
# Do NOT add: prism self-backup, venue keys, a units-only timer, off-site clock.
# v1: pull FROM prism-gateway onto finley (b2-puller). No replica. No machine rename.
OnCalendar=*-*-* *:20:00 America/New_York
AccuracySec=1min
Persistent=true
Unit=b2-puller.service

[Install]
WantedBy=timers.target
