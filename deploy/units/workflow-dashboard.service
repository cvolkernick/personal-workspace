[Unit]
Description=Workflow Management dashboard backend (personal-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/personal-workspace:%h/personal-workspace/projects-dashboard
ExecStart=/usr/bin/python3 %h/personal-workspace/projects-dashboard/server.py --bind 0.0.0.0 --port 8765 --no-browser --local
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
