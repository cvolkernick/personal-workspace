[Unit]
Description=Auto Fleet internal ops dashboard (personal-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/personal-workspace
ExecStart=/usr/bin/python3 %h/personal-workspace/auto-fleet/server.py --host 0.0.0.0 --port 8796 --no-browser
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
