[Unit]
Description=One job: pull prism book snapshots + youtube-groom state + published copies + units onto finley
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=B2_ROLE=b2-puller
Environment=B2_PULL_DEST=%h/b2-pulls/prism
Environment=B2_PULL_REMOTE=prism-agent@prism-gateway
# Live pull only on finley-gateway. Do not write Vercel / Mac dests.
ExecStart=/usr/bin/python3 %h/personal-workspace/deploy/b2-puller/pull_from_prism.py
Nice=10
