[Unit]
Description=Pull personal-workspace work/treasury (FCC SoT pin) and restart dashboard units if changed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/personal-workspace
Environment=WORKSPACE_DIR=%h/personal-workspace
Environment=SYNC_BRANCH=work/treasury
Environment=FCC_LIVE_TREE=main
# Unit file lives in ~/.config (survives git reset). Refuse a wrong SYNC_BRANCH
# even if an operator overrides the env — never reset FCC live root to master.
ExecStartPre=/bin/bash -c 'if [ "${SYNC_BRANCH}" != "work/treasury" ]; then echo "FCC live root refuses SYNC_BRANCH=${SYNC_BRANCH:-unset} (allowlist: work/treasury only)" >&2; exit 1; fi'
# Durable copy — work/treasury does not contain deploy/workspace_sync.sh (#661).
ExecStart=/bin/bash %h/.config/personal-workspace/workspace_sync.sh
