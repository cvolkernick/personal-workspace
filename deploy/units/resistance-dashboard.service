[Unit]
Description=Resistance / fitness dashboard backend (personal-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/personal-workspace:%h/personal-workspace/resistance-dashboard
ExecStart=/usr/bin/python3 %h/personal-workspace/resistance-dashboard/server.py --host 0.0.0.0 --port 8787 --no-browser --local
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
