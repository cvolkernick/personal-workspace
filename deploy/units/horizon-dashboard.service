[Unit]
Description=Horizon Macro dashboard backend (personal-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/personal-workspace
ExecStart=/usr/bin/python3 %h/personal-workspace/research/horizon/server.py --host 0.0.0.0 --port 8795 --no-browser --bootstrap --local
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
