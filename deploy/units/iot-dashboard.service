[Unit]
Description=IoT dashboard + schedule worker backend (personal-workspace)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/personal-workspace
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/personal-workspace
ExecStart=/usr/bin/python3 %h/personal-workspace/iot/server.py --host 0.0.0.0 --port 8780 --no-browser --local
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
